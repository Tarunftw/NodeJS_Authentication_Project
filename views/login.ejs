<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <style>
    body{
      background-color: black;
    }
    .container{
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 10vh;
      border: 3px solid greenyellow;
      border-radius: 10px;
      width: 30vw;
      padding: 2em;
    }
    label{
      color: white;
      font-size: 20px;
    }
    
  </style>
</head>
<body>
  <div class="container">
    <form action="/login" method="post">

      <h1 class="text-center pb-3 text-white">User Login</h1>

      <div class="mb-3">
        <label for="exampleInputEmail" class="form-label">Email address</label>
        <input type="email" name="email" class="form-control" id="exampleInputEmail" >
      </div>

      <div class="mb-3">
        <label for="exampleInputPassword" class="form-label">Password</label>
        <input type="password" name="password" class="form-control" id="exampleInputPassword">
      </div>
      
      <div class="d-grid col-6 mx-auto">
        <button type="submit" class="btn btn-primary fs-5">Login</button>
      </div>

      <div class="d-flex justify-content-end text-light pt-4">
        Don't have an account? <a href="/register" class="text-warning">Register</a>
      </div>
    </form>
    
    
  </div>
</body>
</html>